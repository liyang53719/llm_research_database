        <mxCell id="00_覆盖口径与结构索引_166" value="&lt;b&gt;Color grammar&lt;/b&gt;&lt;br&gt;Blue: large matrix multiplication/projection suited to MAC arrays. Purple: normalization, nonlinear, elementwise, routing/top-k, reshape, mask, state update and other non-matrix operators. Green: cache/state. Red: weights. Orange/yellow: input/residual." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;dashed=1;fontSize=9;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="2200.000" y="250.000" width="930.000" height="120.000" as="geometry" />
        </mxCell>
        <mxCell id="00_覆盖口径与结构索引_167" value="&lt;b&gt;Footprint grammar&lt;/b&gt;&lt;br&gt;All atlas pages use 1 px² = 4 KiB. Weight rectangles preserve byte volume and matrix aspect ratio. MoE pages expand expert bodies instead of hiding them behind one opaque node. Logical activations are named-tensor volumes, not a peak-liveness allocator result." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;dashed=1;fontSize=9;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="2200.000" y="390.000" width="930.000" height="130.000" as="geometry" />
        </mxCell>
        <mxCell id="00_覆盖口径与结构索引_168" value="&lt;b&gt;Revision focus&lt;/b&gt;&lt;br&gt;This revision adds the long-tail families from the snapshot and keeps the guardrails requested by the user: reduced line crossings, no overlapping red weight rectangles, and explicit expansion of complex operators rather than placeholder “black-box” blocks." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;dashed=1;fontSize=9;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="2200.000" y="540.000" width="930.000" height="120.000" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
